// Shared Vulpra iOS 15+ build contract.
#include "BuildIdentity.generated.xcconfig"
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
ARCHS = arm64
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_STYLE = Automatic
VULPRA_DISTRIBUTION_PROFILE = external-signing
VULPRA_ENGINE_ROOT = $(SRCROOT)/.build/engine
VULPRA_ENGINE_CONTRACT = $(SRCROOT)/Configuration/engine-artifact-v4.json
VULPRA_ENGINE_CONTRACT[sdk=iphonesimulator*] = $(SRCROOT)/Configuration/engine-artifact-simulator-v4.json
HEADER_SEARCH_PATHS = $(inherited)
LIBRARY_SEARCH_PATHS = $(inherited)
