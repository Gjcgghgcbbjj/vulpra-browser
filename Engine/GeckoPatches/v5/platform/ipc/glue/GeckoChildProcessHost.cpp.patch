 void GeckoChildProcessHost::OnProcessLaunchError(const LaunchError aError) {
-  MonitorAutoLock lock(mMonitor);
-  mProcessState = PROCESS_ERROR;
-  lock.Notify();
+#if defined(XP_IOS)
+  int32_t failureCode = kFailureProcessLaunch;
+  const char* reason = "process-launch";
+  const char* function = aError.FunctionName().get();
+  if (!strcmp(function, "NSExtensionProcess::StartProcess")) {
+    failureCode = kFailureExtensionStart;
+    reason = "extension-start";
+  } else if (strstr(function, "MakeLibXPCConnection") ||
+             strstr(function, "xpc_connection_send_message_with_reply")) {
+    failureCode = kFailureXPCTransport;
+    reason = "xpc-transport";
+  } else if (strstr(function, "BootstrapReply")) {
+    failureCode = kFailureBootstrapReply;
+    reason = "bootstrap-reply";
+  }
+  NotifyChildLifecycle(kChildFailed, failureCode, 0, reason);
+#endif
+  {
+    MonitorAutoLock lock(mMonitor);
+    mProcessState = PROCESS_ERROR;
+    lock.Notify();
+  }
 }
 
