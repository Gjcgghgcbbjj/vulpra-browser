+#if defined(XP_IOS)
+void GeckoChildProcessHost::NotifyChildLifecycle(int32_t aStage,
+                                                 int32_t aFailureCode,
+                                                 int32_t aPid,
+                                                 const char* aReason) {
+  if (!mLaunchID || aStage < kChildRequested || aStage > kChildTerminated) {
+    return;
+  }
+  {
+    MonitorAutoLock lock(mMonitor);
+    uint32_t stageBit = 1u << static_cast<uint32_t>(aStage);
+    if (mLifecycleStages & stageBit) {
+      return;
+    }
+    if (aStage == kChildIPCConnected) {
+      if (mLifecycleOutcome != 0) {
+        return;
+      }
+      mLifecycleOutcome = 1;
+    } else if (aStage == kChildFailed) {
+      if (mLifecycleOutcome != 0) {
+        return;
+      }
+      mLifecycleOutcome = 2;
+    }
+    mLifecycleStages |= stageBit;
+  }
+  GeckoChildProcessDidChange(
+      mLaunchID, static_cast<int32_t>(mChildID), aPid,
+      XRE_GeckoProcessTypeToString(mProcessType), aStage, aFailureCode,
+      aReason);
+}
+#endif
