+void GeckoChildProcessDidChange(uint64_t aLaunchID, int32_t aChildID,
+                                int32_t aPid, const char* aProcessType,
+                                int32_t aStage, int32_t aFailureCode,
+                                const char* aReason) {
+  if (!gRuntime || !aProcessType) {
+    return;
+  }
+  struct timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return;
+  }
+  uint64_t timestamp = static_cast<uint64_t>(now.tv_sec) * 1000000000ULL +
+                       static_cast<uint64_t>(now.tv_nsec);
+  NSString* processType = [NSString stringWithUTF8String:aProcessType];
+  NSString* reason = aReason ? [NSString stringWithUTF8String:aReason] : nil;
+  [gRuntime childProcessDidChangeWithLaunchID:aLaunchID
+                                      childID:aChildID
+                                          pid:aPid
+                                  processType:processType
+                                        stage:(GeckoChildProcessStage)aStage
+               monotonicTimestampNanoseconds:timestamp
+                                  failureCode:
+                                      (GeckoChildProcessFailureCode)aFailureCode
+                                       reason:reason];
+}
